+def _synthetic_inventory_text(manifest, root, injections=()):
+    """Build a well-formed INV/MODULE/AXIOMS/CLOSURE transcript for synthetic execute."""
+    from collections import Counter
+    modules = {gate.PACKAGE + '.' + path[len(gate.PACKAGE) + 1:-5] for path in manifest['source_modules']}
+    target_module = {}
+    for path in manifest['source_modules']:
+        mod = gate.PACKAGE + '.' + path[len(gate.PACKAGE) + 1:-5]
+        text = (root / path).read_text()
+        definitions = []
+        for name in gate.grammar_check(text, path, definitions):
+            target_module[gate.PACKAGE + '.' + name] = mod
+    counts = Counter()
+    constants = []
+    for target in manifest['targets']:
+        mod = target_module[target]
+        constants.append(('theorem', 'user', mod, target))
+        counts[mod] += 1
+    for kind, origin, mod, name in manifest['compiled_inventory']:
+        constants.append((kind, origin, mod, name))
+        counts[mod] += 1
+    for kind, origin, mod, name in injections:
+        constants.append((kind, origin, mod, name))
+        counts[mod] += 1
+    lines = []
+    for mod in sorted(modules):
+        lines.append('MODULE|' + gate.encode(tuple(mod.split('.'))) + '|false|' + str(counts[mod]) + '|0')
+    lines.append('MODULE|' + gate.encode((gate.PACKAGE,)) + '|false|0|0')
+    for kind, origin, mod, name in constants:
+        lines.append('INV|' + kind + '|' + origin + '|' +
+                     gate.encode(tuple(mod.split('.')) if isinstance(mod, str) else mod) + '|' +
+                     gate.encode(tuple(name.split('.')) if isinstance(name, str) else name))
+    lines.append('AXIOMS|')
+    lines.append('CLOSURE|' + str(sum(counts.values())))
+    return '\n'.join(lines)
+
